@using StaffHub.PLL.ViewModels.DepartmentVM
@model UpdateDepartmentVM

@if ( Model is null)
{
    <div class= "alert alert-info mt-3" >
        <h2>"Department not Found"</h2>
     </div>    
}

else
{
    <div class="row justify-content-center align-content-center mt-3">
        <h1 class="col-8 my-4">Edit Department</h1>
        <form method="post" asp-controller="Department" asp-action="Edit" class="col-8">
            <div class="form-group mb-3">  
                <input type="hidden" asp-for="Id" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label class="form-label" asp-for="code"></label>
                <input asp-for="code" class="form-control" />
                <span asp-validation-for="code" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="form-label" asp-for="Description"></label>
                <textarea class="form-control" asp-for="Description"></textarea>
            </div>
           
            <div class="mt-4 m-auto">
                <input class="btn btn-success" type="submit" value="Edit" />
                <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
            </div>
        </form>
    </div>
}
